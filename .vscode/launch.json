{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Bot (build)",
			"program": "${workspaceFolder}/dist/index.js",
			"preLaunchTask": "tsup: build",
			"cwd": "${workspaceFolder}",
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"sourceMaps": true,
			"smartStep": true,
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Launch Bot (watch)",
			"program": "${workspaceFolder}/dist/index.js",
			"preLaunchTask": "tsup: dev",
			"cwd": "${workspaceFolder}",
			"outFiles": ["${workspaceFolder}/dist/**/*.js"],
			"sourceMaps": true,
			"smartStep": true,
			"skipFiles": ["<node_internals>/**"]
		}
	]
}